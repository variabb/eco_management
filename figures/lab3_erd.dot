digraph G {
  graph [rankdir=LR, fontname="DejaVu Sans", bgcolor="white", nodesep=.6, ranksep=1.1, splines=polyline, pad=.3];
  node [shape=record, fontname="DejaVu Sans", fontsize=12, style="rounded,filled", fillcolor="#EAF2FA", color="#60809A", penwidth=1.15];
  edge [color="#8395A8", arrowsize=.7];
  dept [label="{departments|id PK\lname\lparent_id FK\lheated_area\l}"];
  res [label="{resources|id PK\lname\lunit\l}"];
  link [label="{department_resources|department_id FK\lresource_id FK\l}"];
  cons [label="{consumption|id PK\ldepartment_id FK\lresource_id FK\lyear, month\lamount\l}"];
  tariffs [label="{tariffs|id PK\lresource_id FK\ldepartment_id FK?\lprice, start_date, end_date\l}"];
  prod [label="{production|department_id FK\lyear, month\lrevenue\l}"];
  cond [label="{monthly_conditions|department_id FK\lyear, month\lworking_days\loutdoor_temp\l}"];
  finances [label="{monthly_finances|department_id FK\lyear, month\ltotal_expenses\l}"];
  gen [label="{monthly_generation|department_id FK\lresource_id FK\lyear, month\lamount\l}"];
  emissions [label="{monthly_emissions|department_id FK\lyear, month\lco2_kg\l}"];
  split [label="{monthly_electricity_breakdown|department_id FK\lyear, month\llighting, cooling, other\l}"];
  note [label="{chart_notes [ЛР №3]|chart_key PK\lchart_type, chart_title\lperiod, department_id?\lresource_id?, comment\lupdated_at\l}",fillcolor="#FFEAC8",color="#C08A36"];
  dept -> cons;dept -> prod;dept -> cond;dept -> finances;dept -> emissions;dept -> split;dept -> gen;dept -> link;
  res -> link;res -> cons;res -> tariffs;res -> gen;
  note -> dept [style=dashed,label="logical",constraint=false];
}
